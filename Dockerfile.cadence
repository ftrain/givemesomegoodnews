# Cadence build for givemesomegoodnews (Python pipeline + static site + search + admin).
# Authored for Cadence; the repo's own docker-compose.yml is left untouched.
FROM 492970811130.dkr.ecr.us-east-1.amazonaws.com/cadence-dev-base:bun-1.3.1-slim

WORKDIR /app

# The base image is Debian with bun but no Python toolchain: install
# python3 (+ venv/headers), a C toolchain for any source-built wheels,
# and psql, which is how schema.sql gets applied at boot.
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-venv python3-dev \
        build-essential \
        postgresql-client \
        libjpeg62-turbo zlib1g libwebp7 \
        ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PATH="/opt/venv/bin:$PATH"

# Dependency manifest first so the install layer is reused when only code changes.
COPY requirements.txt ./
RUN python3 -m venv /opt/venv \
    && for i in 1 2 3; do \
         timeout 600 /opt/venv/bin/pip install --no-cache-dir --retries 5 -r requirements.txt && break; \
         echo "pip install stalled/failed (attempt $i), retrying"; sleep 5; \
       done \
    && /opt/venv/bin/python -c "import psycopg, feedparser, yaml, requests, PIL; print('python deps ok')"

# Then the application: the pipeline, the catalog data, and the committed site.
COPY . .

RUN mkdir -p site/img

EXPOSE 8000 8081 8082

# Default process: serve the generated site. cadence.json overrides this per service.
CMD ["python3", "-m", "http.server", "8000", "--directory", "site"]
