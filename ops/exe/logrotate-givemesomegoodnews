# The crawl, the build, the trending job and the nightly pass all append to
# these, every few minutes, for ever. Without this they are the one thing on
# the box that only grows.
#
# copytruncate because the jobs hold their log open through a run: rotating
# out from under them would leave them writing to a file nobody can see.
/srv/givemesomegoodnews/log/*.log {
	weekly
	rotate 8
	compress
	delaycompress
	missingok
	notifempty
	copytruncate
	su givemesomegoodnews givemesomegoodnews
}
