[Unit]
Description=givemesomegood.news admin
After=network.target postgresql.service
Requires=postgresql.service

[Service]
User=givemesomegoodnews
WorkingDirectory=/srv/givemesomegoodnews/app
Environment=DATABASE_URL=postgresql:///givemesomegoodnews
Environment=ADMIN_EMAIL=ford@ftrain.com
ExecStart=/srv/givemesomegoodnews/venv/bin/python3 -m givemesomegoodnews.admin 8082
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
